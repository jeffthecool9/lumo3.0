# Server-only configuration. Copy values into the ignored .env file.
APP_URL=http://127.0.0.1:5173
PORT=3001
HOST=127.0.0.1
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public Firebase web configuration; no VITE_ secret values.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Server only. Prefer a managed credential identity in production.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternatively point to a protected service-account file outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
ALLOW_LIVE_BILLING=false
# Generate a random 32+ character value. Keep stable to preserve trial eligibility hashes.
IDENTITY_HASH_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Recheck the provider's current token prices before enabling paid API calls.
AI_INPUT_USD_PER_MILLION=0.10
AI_OUTPUT_USD_PER_MILLION=0.40
AI_ENABLED=false
AI_PRICING_VERIFIED=false
RESEND_API_KEY=
EMAIL_FROM=
